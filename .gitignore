# Files git should never track.
# Grouped by why they are ignored, so it is clear what each line protects.

# Secrets and local configuration.
# Real values live in AWS SSM Parameter Store, never in git.
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*token.json

# Agent worktrees: one folder per task, each its own checkout.
worktrees/

# Local tool output that is not source code.
graphify-out/
.cursor/
jmeter.log

# Editors and operating systems.
.idea/
.vscode/
*.iml
.DS_Store

# Java (api/).
target/
*.class
hs_err_pid*.log

# Node and Next.js (web/, e2e/).
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
playwright-report/
test-results/
blob-report/
.lighthouseci/
npm-debug.log*
pnpm-debug.log*

# Python (legacy/backend only).
__pycache__/
*.pyc
venv/
.venv/

# Terraform (infra/terraform/).
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan

# Legacy runtime leftovers that must never be re-added.
legacy/backend/uploads/
legacy/backend/polluxkart/
legacy/frontend/build/
